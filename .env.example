# Copie para .env.local e use apenas credenciais PÚBLICAS do seu projeto Supabase.
# A URL fica em Settings > API. Nunca use service_role ou secret keys no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cadastro externo também exige SMTP próprio e URLs de retorno no Supabase Auth.
# Credenciais SMTP ficam apenas no backend; nunca use variáveis VITE_* para elas.
