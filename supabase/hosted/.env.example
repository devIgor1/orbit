# Copie para .env nesta pasta. O arquivo .env é ignorado pelo Git.
# Use uma chave Resend com permissão de envio restrita ao domínio verificado.
# Credenciais somente para configurar o backend; nunca use prefixo VITE_.
RESEND_API_KEY=
ORBIT_SMTP_SENDER_EMAIL=
# URL pública usada pela função de convites neste ambiente hospedado.
ORBIT_APP_URL=https://orbit-ashen-six.vercel.app
