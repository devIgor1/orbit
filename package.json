{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check:styles": "node scripts/check-styles.mjs && npm run check:emails",
    "emails:build": "node scripts/build-invitation-email.mjs",
    "emails:preview": "npm run check:emails && node --experimental-strip-types scripts/preview-invitation-email.mjs",
    "check:emails": "node scripts/build-invitation-email.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:onboarding": "playwright test --config playwright.onboarding.config.ts",
    "db:types": "npx supabase gen types typescript --local > src/lib/supabase/database.generated.ts",
    "test:db": "npx supabase test db",
    "db:start": "npx supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:seed": "node supabase/provision-demo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dismissable-layer": "^1.1.20",
    "@radix-ui/react-focus-scope": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
